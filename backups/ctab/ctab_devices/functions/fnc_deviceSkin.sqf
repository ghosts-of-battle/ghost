#include "script_component.hpp"
/*
 * Author: YonV
 * Keeps the open device honest about three things cTab keeps trying to take
 * back: the case art on the bezel, the texture table cTab repaints that bezel
 * from, and the glass rectangle the screen surfaces were laid out into.
 *
 * The art is a [day, night] pair per case, the same shape cTab uses for its own
 * devices. Both go into the table so cTab's night pass can swap them itself;
 * the bezel is set to whichever is current so a case that is already open
 * changes over at dusk without waiting for a reopen.
 *
 * cTab rebuilds cTabIfOpen - texture table included - on every open, AFTER our
 * open hook has run, and repaints the bezel from it on interface init and
 * every night-mode pass. A one-shot fix at open therefore loses: the stock S7
 * and tablet art came back within seconds in game. Called from deviceTick,
 * this re-asserts once a second and the stock art can win for at most that.
 *
 * The glass assert is the same idea for geometry - and it logs what it had to
 * correct, so if something is still fighting over the map rectangle the RPT
 * says so instead of leaving it to a screenshot.
 *
 * Arguments:
 * None
 *
 * Return Value:
 * None
 *
 * Example:
 * call ghost_ctab_devices_fnc_deviceSkin
 */

private _ifName = call FUNC(ifName);
if !(_ifName in DEVICE_DISPLAYS) exitWith {};

private _display = uiNamespace getVariable [_ifName, displayNull];
if (isNull _display) exitWith {};

// Each case as cTab wants it - [day, night]. cTab keeps a night texture beside
// every one of its own devices and picks between the two on each night-mode
// pass, so ghost's cases carry a pair too; the night art is the day art
// multiplied down, generated by data\gen_night.py.
private _pair = switch (_ifName) do {
    case "cTab_Tablet_dlg": {
        [QPATHTOF(data\gft_screen_ca.paa), QPATHTOF(data\gft_screen_night_ca.paa)]
    };
    case "cTab_FBCB2_dlg": {
        [QPATHTOF(data\fbcb4_screen_ca.paa), QPATHTOF(data\fbcb4_screen_night_ca.paa)]
    };
    default {
        [
            [QPATHTOF(data\s23_blk_ca.paa), QPATHTOF(data\s23_blk_night_ca.paa)],
            [QPATHTOF(data\s23_tan_ca.paa), QPATHTOF(data\s23_tan_night_ca.paa)]
        ] select (GVAR(s23Case) == 1)
    };
};

// Which of the two is up, read cTab's way: 0 off, 1 always, 2 after dark.
private _night = false;
private _mode = [_ifName, "nightMode"] call cTab_fnc_getSettings;
if (!isNil "_mode") then {
    _night = _mode == 1 || {_mode == 2 && {sunOrMoon < 0.2}};
};
private _art = _pair select _night;

// The S23's corner mask carries the case's own corner arcs, so it has to wear
// whichever skin the case is wearing - a black mask on the tan phone would
// read as four dark chips out of the frame.
//
// Only while the mask is up. It is OFF at the moment (FUNC(androidLayout) is
// the single switch), and ctrlShown is how this knows, so there is never a
// second place to remember to change.
private _mask = _display displayCtrl IDC_S23_MASK;
if (!isNull _mask && {ctrlShown _mask}) then {
    private _maskArt = [
        QPATHTOF(data\s23_blk_mask_ca.paa),
        QPATHTOF(data\s23_tan_mask_ca.paa)
    ] select (GVAR(s23Case) == 1);
    if (ctrlText _mask != _maskArt) then {
        _mask ctrlSetText _maskArt;
    };
};

private _bezel = _display displayCtrl S7_IDC_BEZEL;
if (!isNull _bezel && {ctrlText _bezel != _art}) then {
    _bezel ctrlSetText _art;
};

// The runtime case overlay wears the same art as the bezel, always - it is
// the case, painted a second time over the content (see FUNC(androidLayout)).
// Asserted here like the bezel so cTab's night pass cannot split the pair.
private _overlay = _display getVariable [QGVAR(caseOverlay), controlNull];
if (!isNull _overlay && {ctrlText _overlay != _art}) then {
    _overlay ctrlSetText _art;
};

// The whole-interface position assert. The GFT and FBCB4 layouts refit the
// case, and cTab's dialog machinery can translate every config control back
// afterwards - dlgIfPosition saves the refit on close as if the player had
// dragged the dialog, and replays it on a later pass. A one-shot layout loses
// that fight without a trace; this undoes the shift the same way cTab applied
// it (every config-declared control, by the same offset) and names it in the
// RPT, so "the layout did not take" can never again be silent.
private _bWant = _display getVariable [QGVAR(bezelRect), []];
if (_bWant isNotEqualTo [] && {!isNull _bezel}) then {
    private _bPos = ctrlPosition _bezel;
    private _dx = (_bPos select 0) - (_bWant select 0);
    private _dy = (_bPos select 1) - (_bWant select 1);
    if (abs _dx > 0.002 || {abs _dy > 0.002}) then {
        diag_log format ["GHOST ctab_devices: %1 case shifted by [%2,%3] after layout - shifting the interface back", _ifName, _dx, _dy];
        {
            if (isClass _x) then {
                {
                    if (isNumber (_x >> "idc")) then {
                        private _idc = getNumber (_x >> "idc");
                        if (_idc > 0) then {
                            private _c = _display displayCtrl _idc;
                            if (!isNull _c) then {
                                private _p = ctrlPosition _c;
                                _p set [0, (_p select 0) - _dx];
                                _p set [1, (_p select 1) - _dy];
                                _c ctrlSetPosition _p;
                                _c ctrlCommit 0;
                            };
                        };
                    };
                } forEach ("true" configClasses _x);
            };
        } forEach ("true" configClasses (configFile >> _ifName));
    };
};

// The table cTab repaints from gets BOTH, so its own night pass swaps the case
// the moment the sun goes down rather than waiting for this to notice.
if (!isNil "cTabIfOpen" && {cTabIfOpen isEqualType []} && {count cTabIfOpen > 9}) then {
    if ((cTabIfOpen select 9) isNotEqualTo _pair) then {
        cTabIfOpen set [9, +_pair];
    };
};

// the laid-out glass, stored by this display's layout function
private _glass = _display getVariable [QGVAR(glass), []];
if (_glass isEqualTo []) exitWith {};

// The screen backdrop is deliberately INSET behind the maps by the layout, so
// it is asserted against THAT rect - checking it against the glass would have
// this dragging it back out every second and undoing it. The maps take the
// glass exactly, and nothing is allowed past it: overspill lands on the case.
private _mapRect = _display getVariable [QGVAR(mapRect), _glass];
private _bgRect = _display getVariable [QGVAR(bgRect), _glass];
{
    private _ctrl = _display displayCtrl _x;
    if (isNull _ctrl) then {continue};
    private _want = [_bgRect, _mapRect] select (_x != S7_IDC_SCREENBG);
    private _pos = ctrlPosition _ctrl;
    private _off = 0;
    {
        _off = _off + abs (_x - (_pos select _forEachIndex));
    } forEach _want;
    if (_off > 0.004) then {
        // name the fight in the RPT, but never flood it
        private _logged = _display getVariable [QGVAR(driftLogged), 0];
        if (_logged < 6) then {
            diag_log format ["GHOST ctab_devices: %1 idc %2 drifted to %3, reset to %4", _ifName, _x, _pos, _want];
            _display setVariable [QGVAR(driftLogged), _logged + 1];
        };
        _ctrl ctrlSetPosition _want;
        _ctrl ctrlCommit 0;
    };
} forEach [S7_IDC_SCREENBG, S7_IDC_MAP, S7_IDC_MAPTOPO];
