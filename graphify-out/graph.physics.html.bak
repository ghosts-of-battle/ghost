n-style placard family sharing one layout (brand line, emblem, rule, centred title, optional caption)", "nodes": ["media_images_signs_v2_plain_tam", "media_images_signs_v2_plain_tas", "media_images_signs_v2_plain_toc", "media_images_signs_v2_plain_ugl", "media_images_signs_v2_plain_uoc", "media_images_signs_v2_plain_viewd", "media_images_signs_v2_plain_tam_plain_sign_template"], "relation": "implement", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "media/images/signs_v2_plain/tam.png"}, {"id": "terrain_name_placards", "label": "Terrain/area name placards (single map name, no caption)", "nodes": ["media_images_signs_v2_plain_tam", "media_images_signs_v2_plain_tas", "media_images_signs_v2_plain_tam_malden", "media_images_signs_v2_plain_tas_stratis"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "media/images/signs_v2_plain/tas.png"}, {"id": "view_distance_access_paths", "label": "View distance control: two access paths plus per-context profiles", "nodes": ["media_images_signs_v2_plain_viewd", "media_images_signs_v2_plain_viewd_backslash_keybind", "media_images_signs_v2_plain_viewd_ace_self_interaction", "media_images_signs_v2_plain_viewd_foot_car_air_profiles", "media_images_signs_v2_plain_viewd_view_distance_menu"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "media/images/signs_v2_plain/viewd.png"}, {"id": "weapons_range_placard_series_plain", "label": "Weapons Range placard series (plain style): base plus Alpha-Echo", "nodes": ["media_images_signs_v2_plain_wep", "media_images_signs_v2_plain_wepa", "media_images_signs_v2_plain_wepb", "media_images_signs_v2_plain_wepc", "media_images_signs_v2_plain_wepd", "media_images_signs_v2_plain_wepe"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "media/images/signs_v2_plain/wep.png"}, {"id": "shared_sign_chrome_plain", "label": "Shared sign chrome: unit banner, skull emblem, plain layout, footer safety caption", "nodes": ["media_images_signs_v2_plain_wep_ghosts_of_battle_banner", "media_images_signs_v2_plain_wep_skull_rifle_emblem", "media_images_signs_v2_plain_wep_plain_placard_layout", "media_images_signs_v2_plain_wep_hot_range_rule", "media_images_signs_v2_plain_wep_lane_check_before_firing"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "media/images/signs_v2_plain/wep.png"}, {"id": "nato_phonetic_sub_range_designations", "label": "NATO phonetic sub-range designations Alpha through Echo", "nodes": ["media_images_signs_v2_plain_wepa_range_alpha", "media_images_signs_v2_plain_wepb_range_bravo", "media_images_signs_v2_plain_wepc_range_charlie", "media_images_signs_v2_plain_wepd_range_delta", "media_images_signs_v2_plain_wepe_range_echo", "media_images_signs_v2_plain_wepa_nato_phonetic_naming"], "relation": "implement", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "media/images/signs_v2_plain/wepa.png"}];
// afterDrawing passes ctx already transformed to network coordinate space.
// Draw node positions raw — no manual pan/zoom/DPR math needed.
network.on('afterDrawing', function(ctx) {
    hyperedges.forEach(h => {
        const positions = h.nodes
            .map(nid => network.getPositions([nid])[nid])
            .filter(p => p !== undefined);
        if (positions.length < 2) return;
        ctx.save();
        ctx.globalAlpha = 0.12;
        ctx.fillStyle = '#6366f1';
        ctx.strokeStyle = '#6366f1';
        ctx.lineWidth = 2;
        ctx.beginPath();
        // Centroid and expanded hull in network coordinates
        const cx = positions.reduce((s, p) => s + p.x, 0) / positions.length;
        const cy = positions.reduce((s, p) => s + p.y, 0) / positions.length;
        const expanded = positions.map(p => ({
            x: cx + (p.x - cx) * 1.15,
            y: cy + (p.y - cy) * 1.15
        }));
        ctx.moveTo(expanded[0].x, expanded[0].y);
        expanded.slice(1).forEach(p => ctx.lineTo(p.x, p.y));
        ctx.closePath();
        ctx.fill();
        ctx.globalAlpha = 0.4;
        ctx.stroke();
        // Label
        ctx.globalAlpha = 0.8;
        ctx.fillStyle = '#4f46e5';
        ctx.font = 'bold 11px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(h.label, cx, cy - 5);
        ctx.restore();
    });
});
</script>
</body>
</html>
